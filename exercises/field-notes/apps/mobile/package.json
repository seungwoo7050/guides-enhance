{
  "name": "@field-notes/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "bundle:android": "expo export --platform android --output-dir dist/android --clear",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios --clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@field-notes/core": "1.0.0",
    "@field-notes/lifecycle-engine": "1.0.0",
    "@field-notes/sync-engine": "1.0.0",
    "expo": "~57.0.11",
    "expo-background-task": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
