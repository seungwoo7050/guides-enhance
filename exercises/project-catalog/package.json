{
  "name": "project-catalog",
  "private": true,
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "next build",
    "start": "next start",
    "test:e2e": "npm run build && node scripts/run-playwright.mjs",
    "smoke": "npm run build && node scripts/smoke-production.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/run-playwright.mjs && node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
