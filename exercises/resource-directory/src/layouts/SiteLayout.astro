---
import "../styles/global.css";
import { buildCanonicalUrl, buildPageTitle, SITE_DESCRIPTION, SITE_NAME } from "../lib/seo";

type Props = {
  title?: string;
  description?: string;
  canonicalPath: string;
};

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath
} = Astro.props;
const pageTitle = buildPageTitle(title);
const canonical = buildCanonicalUrl(canonicalPath, Astro.site);
const canonicalHref = canonical.toString();
const buildLabel = import.meta.env.PUBLIC_BUILD_LABEL ?? "local";
---

<!-- [Implementation 5]
     Shared metadata and document landmarks are rendered once for every static route. -->
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173a34" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{SITE_NAME}</a>
      <nav aria-label="주요 메뉴">
        <a href="/resources/">전체 자료</a>
        <a href="/categories/web/">웹</a>
        <a href="/categories/data/">데이터</a>
        <a href="/categories/tooling/">도구</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>정적 HTML을 기본으로 만들고 필요한 상호작용만 브라우저에서 실행합니다.</p>
      <p>Build: <code>{buildLabel}</code></p>
    </footer>
  </body>
</html>
